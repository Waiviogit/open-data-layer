{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@opden-data-layer/core": ["../../libs/core/src/index.ts"],
      "@opden-data-layer/core/object-type-registry": [
        "../../libs/core/src/object-type-registry/index.ts"
      ],
      "@opden-data-layer/core/update-registry": [
        "../../libs/core/src/update-registry/index.ts"
      ],
      "@opden-data-layer/core/update-types": [
        "../../libs/core/src/update-registry/update-types.ts"
      ],
      "@opden-data-layer/core/post-related-images": [
        "../../libs/core/src/post-related-images/index.ts"
      ],
      "@opden-data-layer/core/post-objects/comment-post-object-candidates": [
        "../../libs/core/src/post-objects/comment-post-object-candidates.ts"
      ],
      "@opden-data-layer/core/hive-account-history": [
        "../../libs/core/src/hive-account-history/index.ts"
      ],
      "@opden-data-layer/core/hive-datetime": [
        "../../libs/core/src/hive-thread/hive-datetime.util.ts"
      ],
      "@opden-data-layer/core/hive-advanced-report": [
        "../../libs/core/src/hive-advanced-report/index.ts"
      ],
      "@opden-data-layer/core/waiv-advanced-report": [
        "../../libs/core/src/waiv-advanced-report/index.ts"
      ],
      "@opden-data-layer/core/hive-engine-history": [
        "../../libs/core/src/hive-engine-history/index.ts"
      ],
      "@opden-data-layer/core/constants": [
        "../../libs/core/src/constants/index.ts"
      ],
      "@opden-data-layer/core/utils/numeric-string": [
        "../../libs/core/src/utils/numeric-string.ts"
      ],
      "@opden-data-layer/core/utils/obl-usd-amount": [
        "../../libs/core/src/utils/obl-usd-amount.ts"
      ],
      "@opden-data-layer/core/utils/service-order-schema": [
        "../../libs/core/src/utils/service-order-schema.ts"
      ],
      "@opden-data-layer/core/utils/osl-messaging": [
        "../../libs/core/src/utils/osl-messaging.ts"
      ],
      "@opden-data-layer/odl-db-types": [
        "../../libs/odl-db-types/src/index.ts"
      ],
      "@opden-data-layer/migrations": ["../../libs/migrations/src/index.ts"],
      "@opden-data-layer/clients": ["../../libs/clients/src/index.ts"],
      "@opden-data-layer/objects-domain": [
        "../../libs/objects-domain/src/index.ts"
      ],
      "@opden-data-layer/site-canonical": [
        "../../libs/site-canonical/src/index.ts"
      ],
      "@opden-data-layer/hive-processor": [
        "../../libs/hive-processor/src/index.ts"
      ],
      "@opden-data-layer/hive-broadcast": [
        "../../libs/hive-broadcast/src/index.ts"
      ],
      "@opden-data-layer/hive-memo-crypto": [
        "../../libs/hive-memo-crypto/src/index.ts"
      ],
      "@opden-data-layer/hive-account": [
        "../../libs/hive-account/src/index.ts"
      ],
      "@opden-data-layer/notifications-contract": [
        "../../libs/notifications-contract/src/index.ts"
      ],
      "@opden-data-layer/notifications-messages": [
        "../../libs/notifications-messages/src/index.ts"
      ],
      "@opden-data-layer/notifications-messages/testing": [
        "../../libs/notifications-messages/src/testing/index.ts"
      ]
    },
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "emitDeclarationOnly": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    "../../apps/web/.next/types/**/*.ts",
    "../../dist/apps/web/.next/types/**/*.ts",
    "next-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "jest.config.ts",
    "jest.config.cts",
    "**/*.spec.ts",
    "**/*.test.ts",
    ".next/dev/**"
  ]
}
