# =============================================================================
# query-api — copy to `.env` next to this file.
#
# Local `pnpm nx serve query-api`: use `localhost` below.
# Full stack `docker compose` at repo root overrides host/ports for the Docker
# network via root `.env` — see repo root `.env.example`.
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=odl
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_POOL_MAX=10

REDIS_URI=redis://localhost:6379

# Hive RPC fallback for GET /posts/:author/:permlink when the post is not in Postgres.
# Uses HIVE_RPC_NODES from @opden-data-layer/clients; optional tuning (same as chain-indexer):
# HIVE_CACHE_PREFIX=
# HIVE_CACHE_TTL_SECONDS=
# HIVE_MAX_RESPONSE_TIME_MS=
# HIVE_URL_ROTATION_DB=

# Must match auth-api JWT_SECRET so access tokens from auth-api verify here.
# Required for JWT routes: OBL offer drafts (GET/PATCH /users/:author/obl-drafts).
JWT_SECRET=change-me-in-dev

# Changelly liquid-HIVE → BTC/LTC/ETH withdraw (PKCS8 DER private key, hex). Optional locally.
# CHANGELLY_PRIVATE_KEY=
# CHANGELLY_BASE_URL=https://api.changelly.com/v2

# Governance object ID in the DB for ObjectView resolution. When unset or empty, the default snapshot is used.
# GOVERNANCE_OBJECT_ID=

# Public origin for ipfs-gateway content URLs (no trailing path). CIDs: {origin}/ipfs-gateway/content/image/{cid}
# IPFS_CONTENT_BASE_URL=https://example.com

# HTTP listen port (Nest uses PORT; default 7000)
PORT=7000

# GeoLite2-City MMDB for in-process country / lat-lon lookups.
# Local nx serve + infra geoipupdate bind-mount: data/geoip/GeoLite2-City.mmdb
# Docker query-api defaults to /usr/share/GeoIP/GeoLite2-City.mmdb
GEOIP_DB_PATH=data/geoip/GeoLite2-City.mmdb
# Hop count for Express trust proxy. 0 locally (do not trust spoofed X-Forwarded-For).
# Compose sets TRUST_PROXY=1 (nginx, or web after it copies X-Forwarded-For unchanged).
TRUST_PROXY=0

# Advanced report: exclude peg/swap transfers (legacy SWAP_HIVE_ACC). Set empty to disable.
# HIVE_SWAP_ACCOUNT=honey-swap

# Instacart recipe shopping links (optional). Empty key → plain instacart.com/.ca, no IDP.
# INSTACART_KEY=
# INSTACART_HOST=connect.dev.instacart.tools

# OpenAI structured JSON (optional). Used to format Instacart recipe ingredients on IDP miss.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna
