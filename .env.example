# =============================================================================
# Workspace .env for docker compose + optional Nx. Copy to `.env` and adjust.
#
# All variables below are optional for compose: every key has a default in the
# compose files (see root `docker-compose.yml`, which includes `docker-compose.infra.yml`).
# For production, change JWT_SECRET and POSTGRES_PASSWORD.
#
# VPS repo install path (must match `INSTALL_DIR` in setup-vps when using Portainer stacks from disk)
# -----------------------------------------------------------------------------
INSTALL_DIR=/opt/open-data-layer

# -----------------------------------------------------------------------------
# stack-watchdog (optional — VPS compose enables it on the stack-watchdog service)
# Matches docker-compose.<DEPLOY_ENV>.apps.yml on this host; setup-vps appends DEPLOY_ENV when missing.
# On laptop development keep STACK_WATCHDOG_ENABLED unset or false (omit DEPLOY_ENV unless testing sync).
# -----------------------------------------------------------------------------
# DEPLOY_ENV=staging
# STACK_WATCHDOG_ENABLED=false

# Docker stack expects Docker network hostnames (postgres, redis, ipfs, …).
# For `pnpm nx serve <app>` on the host, use per-app `.env` under apps/* with
# localhost — see each app's `.env.example`.
# =============================================================================
NX_LOAD_DOT_ENV_FILES=true

# -----------------------------------------------------------------------------
# Public entry (only published port)
# -----------------------------------------------------------------------------
NGINX_HTTP_PORT=80

# -----------------------------------------------------------------------------
# SSL — required for staging/production (jonasal/nginx-certbot)
# Set DOMAIN to your real domain and CERTBOT_EMAIL to a valid address.
# On first `docker compose up`, certbot will request a certificate from Let's Encrypt.
# -----------------------------------------------------------------------------
DOMAIN=example.com
CERTBOT_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# PostgreSQL (postgis/postgis image + apps)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=odl
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_POOL_MAX=10

# -----------------------------------------------------------------------------
# Redis + IPFS (internal URLs — use service names)
# -----------------------------------------------------------------------------
REDIS_URI=redis://redis:6379
IPFS_API_URL=http://ipfs:5001
# Public origin for ipfs-gateway image URLs (query-api + web). No trailing path.
# Runtime compose `.env` only — deploy-specific vars are not baked into app images at build.
IPFS_CONTENT_BASE_URL=https://${DOMAIN}

# -----------------------------------------------------------------------------
# Internal HTTP listen ports (not published to host; used inside the network)
# -----------------------------------------------------------------------------
QUERY_API_PORT=7000
AUTH_API_PORT=7100
NOTIFICATIONS_PORT=7200
IPFS_GATEWAY_APP_PORT=7300
WEB_PORT=3000

# -----------------------------------------------------------------------------
# Auth (query-api, auth-api, notifications, ipfs-gateway upload, web AUTH_JWT_SECRET)
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-min-16-chars-for-dev
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Web (Next.js server-side fetches over Docker network)
# -----------------------------------------------------------------------------
QUERY_API_URL=http://query-api:7000
AUTH_API_BASE_URL=http://auth-api:7100
# Client notifications WebSocket (runtime; set on staging/production — not baked into image)
# Use your public HTTPS origin + /notifications/ws (nginx proxies to notifications:7200).
# Example: NOTIFICATIONS_WS_PUBLIC_URL=wss://example.com/notifications/ws
NOTIFICATIONS_WS_PUBLIC_URL=

# Hive tx links on update cards (runtime; domain + path, no trailing slash).
# Default when unset: https://hiveblockexplorer.com/tx
# HIVE_TX_EXPLORER_BASE_URL=https://hiveblockexplorer.com/tx

# Telegram bot for web /notifications intro (username without @)
# NOTIFICATIONS_TELEGRAM_BOT_USERNAME=WaivioNotificationsBot

# notifications service — Telegram delivery (optional; omit TELEGRAM_BOT_TOKEN to disable)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_OPS_BOT_TOKEN=
# WEB_PUBLIC_ORIGIN=https://${DOMAIN}

# HiveSigner (auth-api) — implicit flow; defaults match Waivio prod app `www.waivio.com`.
# Override only if using a different HiveSigner app or callback path.
# HIVESIGNER_APP_NAME=www.waivio.com
# HIVESIGNER_CALLBACK_URL=https://${DOMAIN}/api/auth/callback/hivesigner
# AUTH_APP_DISPLAY_ORIGIN=https://${DOMAIN}
# WEB_PUBLIC_ORIGIN=https://${DOMAIN}

# -----------------------------------------------------------------------------
# Optional. CoinGecko / exchange rates — used by OBL USD→WAIV conversion (GET /obl/convert/usd-to-waiv).
# Use COINGECKO_API_BASE_URL=https://pro-api.coingecko.com/api/v3 for Pro.
# COINGECKO_API_KEY=
# EXCHANGE_RATE_ACCESS_KEY=

# Changelly liquid-HIVE withdraw (query-api only; PKCS8 DER private key as hex)
# CHANGELLY_PRIVATE_KEY=
# CHANGELLY_BASE_URL=https://api.changelly.com/v2

# -----------------------------------------------------------------------------
# ODL / OBL Hive custom_json network (web + chain-indexer on the same stack)
#
# Single switch for both object (ODL) and business-ledger (OBL) envelopes.
# Must match on every service that broadcasts or indexes custom_json.
#
#   ODL_NETWORK   ODL custom_json.id   OBL custom_json.id   OSL custom_json.id
#   mainnet       odl-mainnet          obl-mainnet          osl-mainnet
#   testnet       odl-testnet          obl-testnet          osl-testnet
#
# ODL: object_create, update_create, object_follow, …
# OBL: offer_publish, offer_update, contract_sign, invoice_issue, payment_*, dispute_*, …
# See docs/spec/open-business-layer.md
# -----------------------------------------------------------------------------
# ODL_NETWORK=testnet

# -----------------------------------------------------------------------------
# chain-indexer
# Hive parser start block: block number from which the Hive chain parser begins indexing.
# Hive Engine parser start block: block number for the Hive Engine (sidechain) parser.
# Set to a recent block to skip historical data on a fresh VPS.
# -----------------------------------------------------------------------------
START_BLOCK_NUMBER=102138605
HIVE_ENGINE_START_BLOCK=59083591
HANDLER_CUSTOM_JSON_ENABLED=true

# -----------------------------------------------------------------------------
# scheduler (post rewards finalize + reconcile)
# POST_REWARDS_FINALIZE_DELAY_SEC must match chain-indexer when set.
# HIVE_ENGINE_HISTORY_NODES — comma-separated; omit for built-in History API defaults.
# -----------------------------------------------------------------------------
# POST_REWARDS_FINALIZE_DELAY_SEC=900
# POST_REWARDS_FINALIZE_BATCH_SIZE=50
# POST_REWARD_RECONCILE_BATCH_SIZE=1000
# HIVE_ENGINE_HISTORY_NODES=https://accounts.hive-engine.com,https://history.hive-engine.com
