# HTTPS virtual host for staging/production (served by jonasal/nginx-certbot).
# Source of truth in git. scripts/setup-vps.sh generates nginx/conf.d/default.conf on every run via
#   export DOMAIN=<from .env>; envsubst '${DOMAIN}' < default.conf.template > default.conf
# It does NOT delete this template. jonasal may rename default.conf to .nokey until a cert exists;
# setup also removes stale .nokey and recreates nginx so certbot can issue to live/<DOMAIN>/ .
# HTTP for ACME is handled by 00-acme.conf.
#
# Portainer CE is not proxied here — use https://127.0.0.1:9443 on the host (loopback only).
#
# Docker embedded DNS. Upstream DNS refresh needs resolver + upstream zone + server ... resolve (nginx >= 1.27.3 OSS).
resolver 127.0.0.11 valid=10s ipv6=off;

upstream web_app {
    zone web_app 64k;

    server web:3000 resolve;
}

upstream notifications_app {
    zone notifications_app 64k;

    server notifications:7200 resolve;
}

upstream ipfs_gateway_app {
    zone ipfs_gateway_app 64k;

    server ipfs-gateway:7300 resolve;
}

upstream query_api_app {
    zone query_api_app 64k;

    server query-api:7000 resolve;
}

upstream knowledge_api_app {
    zone knowledge_api_app 64k;

    server knowledge-api:7400 resolve;
}

upstream auth_api_app {
    zone auth_api_app 64k;

    server auth-api:7100 resolve;
}

# Per-IP rate limit for auth challenge/verify endpoints
limit_req_zone $binary_remote_addr zone=auth_api_limit:10m rate=10r/s;

server {
    listen 443 ssl;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 30m;

    location /notifications/ws {
        proxy_pass http://notifications_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    location = /query/mcp {
        limit_except POST { deny all; }
        proxy_pass http://query_api_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    location = /knowledge/mcp {
        limit_except POST { deny all; }
        proxy_pass http://knowledge_api_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    # ipfs-gateway (content/namespaces public; upload JWT in app)
    location /ipfs-gateway/ {
        proxy_pass http://ipfs_gateway_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 55m;
    }

    # auth-api (public challenge/verify only after security hardening)
    location /auth/ {
        limit_except GET POST { deny all; }
        limit_req zone=auth_api_limit burst=20 nodelay;
        client_max_body_size 64k;
        proxy_pass http://auth_api_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    location / {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
        proxy_pass http://web_app;
    }
}
